    class RenderEffect <<abstract>> {
        +Activate() <<abstract>>
        +Deactivate() <<abstract>>
        +Refresh() <<abstract>>
        +IsActivated() <<abstract>>
        #GetOffScreenRenderableType() <<abstract>>
    }
    
    class RenderEffectImpl <<abstract>> {
        +Initialize()
        +Activate()
        +Deactivate()
        +GetOffScreenRenderTasks()
        #mOwnerControl: Control
        #mIsActivated: bool
    }
    
    class MaskEffect {
        +New(maskControl)
        +New(maskControl, mode, position, scale)
        +SetTargetMaskOnce()
        +SetSourceMaskOnce()
        +GetTargetMaskOnce()
        +GetSourceMaskOnce()
    }
    
    class MaskEffectImpl {
        -mMaskControl: Control
        -mMaskMode: MaskMode
        -mMaskPosition: Vector2
        -mMaskScale: Vector2
        -mTargetMaskOnce: bool
