@startuml Visual Effects Architecture Diagrams

!theme plain
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

' ============================================
' 1. Visual Effects 아키텍처 전체 구조도
' ============================================

title Visual Effects 아키텍처 전체 구조

package "DALi Core Layer" {
    class Actor {
        +SetProperty()
        +GetProperty()
        +AddRenderer()
    }
    
    class RenderTask {
        +SetSourceActor()
        +SetFrameBuffer()
        +SetOrderIndex()
    }
    
    class RenderTaskList {
        +CreateTask()
        +ReorderTasks()
        +SortTasks()
    }
    
    class FrameBuffer {
        +AttachColorTexture()
        +AttachDepthTexture()
    }
}

package "DALi Toolkit Layer" {
    class Control {
        +SetRenderEffect()
        +ClearRenderEffect()
        +GetRenderEffect()
        -mRenderEffect: RenderEffectImplPtr
    }
    
    class RenderEffect <<abstract>> {
        +Activate()
        +Deactivate()
        +Refresh()
        +IsActivated()
        #GetOffScreenRenderableType()
    }
    
    class RenderEffectImpl <<abstract>> {
        +Initialize()
        +Activate()
        +Deactivate()
        +GetOffScreenRenderTasks()
        #mOwnerControl: Control
        #mIsActivated: bool
    }
    
    class MaskEffect {
        +New(maskControl)
        +New(maskControl, mode, position, scale)
        +SetTargetMaskOnce()
        +SetSourceMaskOnce()
    }
    
    class MaskEffectImpl {
        -mMaskControl: Control
        -mMaskMode: MaskMode
        -mMaskPosition: Vector2
        -mMaskScale: Vector2
    }
    
    class BackgroundBlurEffect {
        +New(blurRadius)
    }
    
    class BackgroundBlurEffectImpl {
        -mBlurRadius: float
        -mCaptureTask: RenderTask
        -mBlurTask: RenderTask
    }
    
    class GaussianBlurEffect {
        +New(blurRadius)
    }
    
    class GaussianBlurEffectImpl {
        -mBlurRadius: float
    }
}

package "NUI Layer" {
    class View {
        +SetRenderEffect()
        +ClearRenderEffect()
        +AddShadow()
        -_ownerView: WeakReference<View>
    }
    
    class RenderEffect {
        +CreateBackgroundBlurEffect()
        +CreateGaussianBlurEffect()
        +CreateMaskEffect()
        +Dispose()
        +AliveCount: int
    }
    
    class MaskEffect {
        +MaskMode: MaskEffectMode
        +Position: Vector2
        +Scale: Vector2
    }
    
    class Shadow {
        +Color: Vector4
        +Offset: Vector2
        +BlurRadius: float
    }
    
    class InnerShadow {
    }
}

' 관계 정의
Actor <|-- Control
Control --> RenderEffect : "owns 1"
RenderEffect <|-- MaskEffect
RenderEffect <|-- BackgroundBlurEffect
RenderEffect <|-- GaussianBlurEffect
RenderEffect --> RenderEffectImpl : "handle"
RenderEffectImpl <|-- MaskEffectImpl
RenderEffectImpl <|-- BackgroundBlurEffectImpl
RenderEffectImpl <|-- GaussianBlurEffectImpl

Control --> RenderTaskList : "uses"
RenderTaskList --> RenderTask : "manages"
RenderTask --> FrameBuffer : "renders to"

View <|-- Control
View --> RenderEffect : "uses"
RenderEffect --> MaskEffect : "creates"
RenderEffect --> Shadow : "creates"

' P/Invoke 관계
RenderEffect ..> RenderEffect : "P/Invoke"
MaskEffect ..> MaskEffect : "P/Invoke"

@enduml

@startuml Visual Effects Class Hierarchy

title Visual Effects 클래스 상속 계층도

