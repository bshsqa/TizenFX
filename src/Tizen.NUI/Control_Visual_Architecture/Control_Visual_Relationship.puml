@startuml Control_Visual_Relationship
!theme plain
skinparam classAttributeIconSize 0

title DALi Control과 Visual의 관계 아키텍처

package "Control Layer" {
    class Control {
        +StyleName: string
        +KeyInputFocus: bool
        +Background: Property::Map
        +Margin: Extents
        +Padding: Extents
        +SetStyleName()
        +SetKeyInputFocus()
        +SetBackgroundColor()
        +ClearBackground()
        +KeyEventSignal()
        +ResourceReadySignal()
    }
    
    class ControlImpl {
        +mControlImpl: Control&
        +mState: DevelControl::State
        +mSubStateName: string
        +OnInitialize()
        +OnStyleChange()
        +OnKeyInputFocusGained()
        +OnKeyInputFocusLost()
        +OnKeyEvent()
    }
    
    class ControlDataImpl {
        +mControlImpl: Control&
        +mState: DevelControl::State
        +mSubStateName: string
        +mAccessibilityData
        +mVisualData
        +mStyleName: string
        +mBackgroundColor: Vector4
        +mMargin: Extents
        +mPadding: Extents
        +RegisterVisual()
        +UnregisterVisual()
        +GetVisual()
        +EnableVisual()
        +SetState()
        +SetSubState()
        +IsResourceReady()
    }
    
    class ImageView {
        +Image: string|Property::Map
        +PreMultipliedAlpha: bool
        +PlaceholderImage: string
        +EnableTransitionEffect: bool
        +TransitionEffectOption: Property::Map
        +PixelArea: Vector4
        +SetImage()
        +New()
    }
    
    class TextLabel {
        +Text: string
        +FontFamily: string
        +FontStyle: string|Property::Map
        +PointSize: float
        +MultiLine: bool
        +HorizontalAlignment: string
        +VerticalAlignment: string
        +TextColor: Vector4
        +EnableMarkup: bool
        +EnableAutoScroll: bool
        +AutoScrollSpeed: int
        +SetProperty()
        +New()
    }
}

package "Visual Management Layer" {
    class VisualFactory {
        +CreateVisual()
        +CreateImageVisual()
        +CreateColorVisual()
        +CreateTextVisual()
        +CreateBorderVisual()
        +CreateGradientVisual()
        +CreatePrimitiveVisual()
    }
    
    class VisualFactoryCache {
        +mRendererCache: Renderer[]
        +mShaderCache: Shader[]
        +mGeometryCache: Geometry[]
        +GetRenderer()
        +GetShader()
        +GetGeometry()
    }
    
    class VisualData {
        +mVisuals: Property::Index -> Visual::Base[]
        +mVisualEnables: Property::Index -> bool[]
        +mVisualResourceStatus: Property::Index -> ResourceStatus[]
        +mVisualDepthIndices: Property::Index -> int[]
        +RegisterVisual()
        +UnregisterVisual()
        +GetVisual()
        +EnableVisual()
        +GetVisualResourceStatus()
    }
}

package "Visual Layer" {
    class VisualBase {
        +Name: string
        +Type: Visual::Type
        +DepthIndex: int
        +MixColor: Vector4
        +SetProperties()
        +SetName()
        +SetTransformAndSize()
        +SetDepthIndex()
        +SetOnScene()
        +SetOffScene()
        +CreatePropertyMap()
        +DoAction()
        +AnimateProperty()
        +ResourceReady()
        +IsResourceReady()
    }
    
    class ImageVisual {
        +mPixelArea: Vector4
        +mImageUrl: VisualUrl
        +mMaskingData: MaskingDataPointer
        +mDesiredSize: ImageDimensions
        +mTextureId: TextureId
        +mTextures: TextureSet
        +mNativeTexture: Texture
        +mTextureSize: Vector2
        +mFittingMode: FittingMode::Type
        +mSamplingMode: SamplingMode::Type
        +mWrapModeU: WrapMode::Type
        +mWrapModeV: WrapMode::Type
        +mLoadPolicy: LoadPolicy::Type
        +mReleasePolicy: ReleasePolicy::Type
        +GetNaturalSize()
        +DoCreatePropertyMap()
        +EnablePreMultipliedAlpha()
        +OnDoAction()
        +DoSetProperties()
        +DoSetOnScene()
        +DoSetOffScene()
        +OnSetTransform()
        +UpdateShader()
        +GenerateShader()
        +UploadCompleted()
        +LoadComplete()
        +FastLoadComplete()
    }
    
    class TextVisual {
        +mText: string
        +mFontFamily: string
        +mFontStyle: Property::Map
        +mPointSize: float
        +mTextColor: Vector4
        +mMultiLine: bool
        +mHorizontalAlignment: HorizontalAlignment::Type
        +mVerticalAlignment: VerticalAlignment::Type
        +mEnableMarkup: bool
        +GetNaturalSize()
        +DoCreatePropertyMap()
        +DoSetProperties()
        +DoSetOnScene()
        +OnSetTransform()
    }
    
    class ColorVisual {
        +mColor: Vector4
        +GetNaturalSize()
        +DoCreatePropertyMap()
        +DoSetProperties()
        +DoSetOnScene()
        +OnSetTransform()
    }
}

package "Rendering Layer" {
    class VisualRenderer {
        +mRenderer: Renderer
        +mGeometry: Geometry
        +mTextureSet: TextureSet
        +mShader: Shader
        +SetRenderer()
        +SetGeometry()
        +SetTextureSet()
        +SetShader()
        +RegisterVisualTransformUniform()
    }
    
    class Renderer {
        +mGeometry: Geometry
        +mMaterial: Material
        +mDepthIndex: int
        +SetGeometry()
        +SetMaterial()
        +SetDepthIndex()
    }
    
    class TextureManager {
        +LoadTexture()
        +UploadTexture()
        +RemoveTexture()
        +GetTexture()
        +AddObserver()
        +RemoveObserver()
    }
}

' 상속 관계
Control <|-- ImageView
Control <|-- TextLabel
VisualBase <|-- ImageVisual
VisualBase <|-- TextVisual
VisualBase <|-- ColorVisual

' 구현 관계
ControlImpl <|.. ControlDataImpl

' 합성 관계
Control *-- ControlImpl : contains
ControlImpl *-- ControlDataImpl : uses
ControlDataImpl *-- VisualData : contains
VisualData *-- VisualBase : manages
VisualFactory *-- VisualFactoryCache : uses
VisualFactory *-- VisualBase : creates
VisualBase *-- VisualRenderer : uses
VisualRenderer *-- Renderer : wraps
ImageVisual *-- TextureManager : uses

' 의존 관계
ImageView ..> ImageVisual : creates
TextLabel ..> TextVisual : creates
ControlDataImpl ..> VisualFactory : uses
ImageVisual ..> TextureManager : loads from

' 메모 설명
note right of Control
  Control은 UI 컴포넌트의 기본 클래스
  - 사용자 입력 처리
  - 스타일링 지원
  - 상태 관리
  - 비주얼 라이프사이클 관리
end note

note right of ControlDataImpl
  Control의 실제 데이터 구현
  - 비주얼 등록 및 관리
  - 상태 전환 처리
  - 리소스 상태 모니터링
  - 접근성 데이터 관리
end note

note right of VisualFactory
  Visual 객체 생성 팩토리
  - 타입 기반 Visual 생성
  - 캐시 관리
  - 리소스 최적화
  - 재사용 가능한 객체 관리
end note

note right of VisualData
  Visual 데이터 관리
  - Visual 등록 및 해제
  - 활성화 상태 관리
  - 깊이 인덱스 관리
  - 리소스 상태 추적
end note

note right of ImageVisual
  이미지 렌더링 비주얼
  - 텍스처 로딩 및 관리
  - 아틀라싱 지원
  - 마스킹 기능
  - 비동기 로딩
end note

note bottom of TextureManager
  텍스처 리소스 관리자
  - 텍스처 로딩 및 캐싱
  - 아틀라싱 최적화
  - 메모리 관리
  - 비동기 업로드 지원
end note

@enduml
